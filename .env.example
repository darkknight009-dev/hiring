# Reserved for the future FastAPI backend. Not loaded by the Flutter preview.
# Copy to .env when the backend stage is implemented. Never commit .env.
# Never pass secrets through --dart-define: web clients are public bundles.

# Planned local database; replace the placeholder password locally.
DATABASE_URL=postgresql+psycopg://hiring_radar:CHANGE_ME@localhost:5432/hiring_radar

# Planned server-side integration settings. No provider is connected yet.
AI_PROVIDER=
AI_API_KEY=
RESEARCH_PROVIDER=
RESEARCH_API_KEY=

# Planned server-side filter setting; not active in the shell milestone.
HIRING_FILTER_THRESHOLD=8
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
